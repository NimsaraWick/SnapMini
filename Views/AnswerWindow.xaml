<Window x:Class="SnapMini.Views.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapMini AI"
        Height="580" Width="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <!-- Outer Container with Obsidian Black Theme & Deep Shadow -->
    <Border Margin="16" CornerRadius="16" Background="#000000" BorderBrush="#362054" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.9"/>
        </Border.Effect>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header -->
                <RowDefinition Height="Auto"/> <!-- 1. Question Card -->
                <RowDefinition Height="*"/>    <!-- 2. Answer & Chat History Card -->
                <RowDefinition Height="Auto"/> <!-- 3. Interactive Follow-up Chat Bar -->
                <RowDefinition Height="Auto"/> <!-- 4. Footer -->
            </Grid.RowDefinitions>

            <!-- 0. Header (Draggable Bar with Position Controls, Model Badge & Settings) -->
            <Border Grid.Row="0" Background="#040407" CornerRadius="15,15,0,0" Padding="14,10" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Badge with SM Logo Image -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppLogoImage" Width="26" Height="26" Margin="0,0,8,0" 
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="SnapMini" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Model Tag -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="8,3" CornerRadius="12" Background="#120924" BorderBrush="#3B1F5E" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C084FC" Offset="0.0"/>
                                        <GradientStop Color="#7C3AED" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="ModelTagText" Text="Gemini 2.5 Flash" Foreground="#E9D5FF" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Pin Button (Always on Top Toggle) -->
                    <Border Grid.Column="2" x:Name="PinBtn" MouseLeftButtonDown="PinButton_Click" ToolTip="Always on Top (Pin)" Cursor="Hand" 
                            Background="Transparent" CornerRadius="6" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PinIconText" Text="📌" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Settings Button -->
                    <Border Grid.Column="3" MouseLeftButtonDown="SettingsButton_Click" ToolTip="Settings (⚙️)" Cursor="Hand" 
                            Background="Transparent" CornerRadius="6" Width="24" Height="24" Margin="4,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Position Selector Pill -->
                    <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="#120924" CornerRadius="8" BorderBrush="#3B1F5E" BorderThickness="1" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="BtnTopLeft" MouseLeftButtonDown="SetPos_TopLeft" ToolTip="Top-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↖" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnTopRight" MouseLeftButtonDown="SetPos_TopRight" ToolTip="Top-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↗" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnCenter" MouseLeftButtonDown="SetPos_Center" ToolTip="Center Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="⊹" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomLeft" MouseLeftButtonDown="SetPos_BottomLeft" ToolTip="Bottom-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↙" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomRight" MouseLeftButtonDown="SetPos_BottomRight" ToolTip="Bottom-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↘" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnFullScreen" MouseLeftButtonDown="SetPos_FullScreen" ToolTip="Full Screen Preset (F11 / F)" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="⛶" Foreground="#C4B5FD" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Border Grid.Column="5" MouseLeftButtonDown="CloseButton_Click" Cursor="Hand" Background="Transparent" CornerRadius="6" Width="24" Height="24" VerticalAlignment="Center" ToolTip="Close (Esc)">
                        <TextBlock Text="✕" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. Question / Captured Context Card -->
            <StackPanel Grid.Row="1" Margin="16,8,16,6">
                <!-- Header Bar with Expand/Collapse Toggle Button on Right -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="CAPTURED CONTEXT" Foreground="#C084FC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Expand / Collapse Icon Toggle -->
                    <Border Grid.Column="1" x:Name="ExpandContextBtn" MouseLeftButtonDown="ExpandContextBtn_Click" Cursor="Hand" 
                            Background="Transparent" CornerRadius="6" Width="24" Height="24" VerticalAlignment="Center" ToolTip="Expand Context">
                        <TextBlock x:Name="ExpandContextIcon" Text="▼" Foreground="#C084FC" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Border Background="#08070D" CornerRadius="10" BorderBrush="#29193D" BorderThickness="1" Padding="10,6">
                    <TextBox x:Name="QuestionBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" 
                             Background="Transparent" Foreground="#E9D5FF" BorderThickness="0"
                             FontSize="12.5" FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"
                             SelectionBrush="#A855F7" SelectionOpacity="0.4"/>
                </Border>
            </StackPanel>

            <!-- 2. Answer & Chat History Card -->
            <Grid Grid.Row="2" Margin="16,4,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AI Conversation Section Header Bar with Save to Docs & Copy Button on the Right -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="AI CONVERSATION" Foreground="#C084FC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Save to Google Docs Button -->
                        <Border x:Name="SaveDocBtn" MouseLeftButtonDown="SaveToDocs_Click" Cursor="Hand" 
                                Background="#1A0D30" BorderBrush="#3B1F5E" BorderThickness="1" CornerRadius="6" 
                                Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Save Q&amp;A to Google Docs / Drive">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SaveDocIcon" Text="📄 " Foreground="#E9D5FF" FontSize="11"/>
                                <TextBlock x:Name="SaveDocBtnText" Text="Save to Docs" Foreground="#E9D5FF" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Copy Button Card -->
                        <Border x:Name="CopyBtn" MouseLeftButtonDown="CopyButton_Click" Cursor="Hand" 
                                Background="#1A0D30" BorderBrush="#3B1F5E" BorderThickness="1" CornerRadius="6" 
                                Padding="8,3" VerticalAlignment="Center" ToolTip="Copy Answer (Ctrl+C)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CopyIcon" Text="📋 " Foreground="#E9D5FF" FontSize="11"/>
                                <TextBlock x:Name="CopyBtnText" Text="Copy" Foreground="#E9D5FF" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#08070D" CornerRadius="12" BorderBrush="#29193D" BorderThickness="1" Padding="12,10">
                    <RichTextBox x:Name="AnswerBox" 
                                 IsReadOnly="True" 
                                 IsDocumentEnabled="True"
                                 Background="Transparent" 
                                 Foreground="#F5F3FF" 
                                 BorderThickness="0"
                                 FontSize="14" 
                                 FontFamily="Segoe UI"
                                 VerticalScrollBarVisibility="Auto"
                                 SelectionBrush="#A855F7" 
                                 SelectionOpacity="0.4"
                                 Cursor="IBeam">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="LineHeight" Value="22"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Border>
            </Grid>

            <!-- 3. Interactive Follow-up Chat Input Bar -->
            <StackPanel Grid.Row="3" Margin="16,0,16,8">
                <!-- Dynamic Quick Action Tags Container (Loaded from Settings) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <StackPanel x:Name="QuickActionsContainer" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Input Box + Send Button Container -->
                <Border Background="#08070D" CornerRadius="10" BorderBrush="#29193D" BorderThickness="1" Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input Field -->
                        <TextBox x:Name="ChatInputBox" 
                                 Background="Transparent" 
                                 Foreground="#FFFFFF" 
                                 BorderThickness="0" 
                                 FontSize="13" 
                                 FontFamily="Segoe UI"
                                 Padding="8,5"
                                 VerticalAlignment="Center"
                                 KeyDown="ChatInputBox_KeyDown"
                                 GotFocus="ChatInputBox_GotFocus"
                                 TextChanged="ChatInputBox_TextChanged"
                                 SelectionBrush="#A855F7" 
                                 SelectionOpacity="0.4"/>

                        <!-- Placeholder Text -->
                        <TextBlock x:Name="ChatPlaceholder" 
                                   Text="Ask a follow-up question... (Press Enter)" 
                                   Foreground="#A78BFA" 
                                   FontSize="13" 
                                   FontFamily="Segoe UI"
                                   Padding="8,5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Send Button with Gradient Accent -->
                        <Border Grid.Column="1" x:Name="SendBtn" MouseLeftButtonDown="SendButton_Click" Cursor="Hand" 
                                CornerRadius="8" Padding="12,5" Margin="2" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9333EA" Offset="0.0"/>
                                    <GradientStop Color="#4F46E5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SendBtnIcon" Text="➤" Foreground="#FFFFFF" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SendBtnText" Text="Send" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Footer Progress Bar, Pause Control & Auto-close status -->
            <Border Grid.Row="4" Background="#040407" CornerRadius="0,0,15,15" Padding="16,6,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="AutoCloseProgress" Grid.Column="0" Height="4" Maximum="250" Value="250" 
                                 Background="#120924" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#9333EA" Offset="0.0"/>
                                <GradientStop Color="#4F46E5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>

                    <!-- Pause / Resume Button -->
                    <Border Grid.Column="1" x:Name="PauseBtn" MouseLeftButtonDown="PauseButton_Click" Cursor="Hand" 
                            Background="#1A0D30" BorderBrush="#3B1F5E" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="Pause / Resume Timer (Space / P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseIcon" Text="⏸ " Foreground="#E9D5FF" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseBtnText" Text="Pause" Foreground="#E9D5FF" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TimerLabel" Grid.Column="2" Text="Auto closing in 25s" Foreground="#C4B5FD" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
