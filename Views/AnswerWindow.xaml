<Window x:Class="SnapMini.Views.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapMini AI"
        Height="580" Width="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">

    <!-- Outer Container with Dark Slate Theme & Deep Shadow -->
    <Border Margin="16" CornerRadius="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header -->
                <RowDefinition Height="Auto"/> <!-- 1. Question Card -->
                <RowDefinition Height="*"/>    <!-- 2. Answer & Chat History Card -->
                <RowDefinition Height="Auto"/> <!-- 3. Interactive Follow-up Chat Bar -->
                <RowDefinition Height="Auto"/> <!-- 4. Footer -->
            </Grid.RowDefinitions>

            <!-- 0. Header (Draggable Bar with Position Controls, Model Badge & Settings) -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="15,15,0,0" Padding="14,10" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Badge with SM Logo Image -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppLogoImage" Width="26" Height="26" Margin="0,0,8,0" 
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="SnapMini" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Model Tag -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="8,3" CornerRadius="12" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelTagText" Text="Gemini 2.5 Flash" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings Button -->
                    <Border Grid.Column="2" MouseLeftButtonDown="SettingsButton_Click" ToolTip="Settings (⚙️)" Cursor="Hand" 
                            Background="Transparent" CornerRadius="6" Width="24" Height="24" Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Position Selector Pill -->
                    <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="BtnTopLeft" MouseLeftButtonDown="SetPos_TopLeft" ToolTip="Top-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↖" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnTopRight" MouseLeftButtonDown="SetPos_TopRight" ToolTip="Top-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↗" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnCenter" MouseLeftButtonDown="SetPos_Center" ToolTip="Center Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="⊹" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomLeft" MouseLeftButtonDown="SetPos_BottomLeft" ToolTip="Bottom-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↙" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomRight" MouseLeftButtonDown="SetPos_BottomRight" ToolTip="Bottom-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↘" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Copy Button Card -->
                    <Border Grid.Column="4" x:Name="CopyBtn" MouseLeftButtonDown="CopyButton_Click" Cursor="Hand" Background="#334155" CornerRadius="8" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CopyIcon" Text="📋 " Foreground="#E2E8F0" FontSize="11"/>
                            <TextBlock x:Name="CopyBtnText" Text="Copy" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Border Grid.Column="5" MouseLeftButtonDown="CloseButton_Click" Cursor="Hand" Background="Transparent" CornerRadius="6" Width="24" Height="24" VerticalAlignment="Center">
                        <TextBlock Text="✕" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. Question / Captured Context Card -->
            <StackPanel Grid.Row="1" Margin="16,10,16,6">
                <TextBlock Text="CAPTURED CONTEXT" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="10,6">
                    <TextBox x:Name="QuestionBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60" 
                             Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                             FontSize="12.5" FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"
                             SelectionBrush="#6366F1" SelectionOpacity="0.5"/>
                </Border>
            </StackPanel>

            <!-- 2. Answer & Chat History Card -->
            <DockPanel Grid.Row="2" Margin="16,4,16,8">
                <TextBlock Text="AI CONVERSATION" DockPanel.Dock="Top" Foreground="#818CF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="12,10">
                    <RichTextBox x:Name="AnswerBox" 
                                 IsReadOnly="True" 
                                 IsDocumentEnabled="True"
                                 Background="Transparent" 
                                 Foreground="#F8FAFC" 
                                 BorderThickness="0"
                                 FontSize="14" 
                                 FontFamily="Segoe UI"
                                 VerticalScrollBarVisibility="Auto"
                                 SelectionBrush="#6366F1"
                                 SelectionOpacity="0.5"
                                 Cursor="IBeam">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="LineHeight" Value="22"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Border>
            </DockPanel>

            <!-- 3. Interactive Follow-up Chat Input Bar -->
            <StackPanel Grid.Row="3" Margin="16,0,16,8">
                <!-- Quick Prompt Suggestion Pills -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Ask Follow-up:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    
                    <Border MouseLeftButtonDown="QuickPrompt_Simpler" Cursor="Hand" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,5,0">
                        <TextBlock Text="💡 Simpler" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                    <Border MouseLeftButtonDown="QuickPrompt_Examples" Cursor="Hand" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,5,0">
                        <TextBlock Text="📝 Examples" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                    <Border MouseLeftButtonDown="QuickPrompt_Grammar" Cursor="Hand" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,5,0">
                        <TextBlock Text="📖 Grammar" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                    <Border MouseLeftButtonDown="QuickPrompt_BulletPoints" Cursor="Hand" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="7,2">
                        <TextBlock Text="📌 Key Points" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Input Box + Send Button Container -->
                <Border Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input Field -->
                        <TextBox x:Name="ChatInputBox" 
                                 Background="Transparent" 
                                 Foreground="#F8FAFC" 
                                 BorderThickness="0"
                                 FontSize="13" 
                                 FontFamily="Segoe UI"
                                 Padding="8,5"
                                 VerticalAlignment="Center"
                                 KeyDown="ChatInputBox_KeyDown"
                                 GotFocus="ChatInputBox_GotFocus"
                                 TextChanged="ChatInputBox_TextChanged"
                                 SelectionBrush="#6366F1"
                                 SelectionOpacity="0.5"/>

                        <!-- Placeholder Text -->
                        <TextBlock x:Name="ChatPlaceholder" 
                                   Text="Ask a follow-up question... (Press Enter)" 
                                   Foreground="#64748B" 
                                   FontSize="13" 
                                   FontFamily="Segoe UI"
                                   Padding="8,5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Send Button -->
                        <Border Grid.Column="1" x:Name="SendBtn" MouseLeftButtonDown="SendButton_Click" Cursor="Hand" 
                                Background="#6366F1" CornerRadius="8" Padding="10,5" Margin="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SendBtnIcon" Text="➤" Foreground="#FFFFFF" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SendBtnText" Text="Send" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Footer Progress Bar, Pause Control & Auto-close status -->
            <Border Grid.Row="4" Background="#0F172A" CornerRadius="0,0,15,15" Padding="16,6,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="AutoCloseProgress" Grid.Column="0" Height="4" Maximum="250" Value="250" 
                                 Foreground="#6366F1" Background="#1E293B" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Pause / Resume Button -->
                    <Border Grid.Column="1" x:Name="PauseBtn" MouseLeftButtonDown="PauseButton_Click" Cursor="Hand" 
                            Background="#334155" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseIcon" Text="⏸ " Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseBtnText" Text="Pause" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TimerLabel" Grid.Column="2" Text="Auto closing in 25s" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
