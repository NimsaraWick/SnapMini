<Window x:Class="SnapMini.Views.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapMini AI"
        Height="520" Width="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">

    <!-- Outer Container with Dark Slate Theme & Deep Shadow -->
    <Border Margin="16" CornerRadius="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Question Card -->
                <RowDefinition Height="*"/>    <!-- Answer Card -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header (Draggable Bar with Position Controls & SM Logo) -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="15,15,0,0" Padding="14,10" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Badge with SM Logo Image -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppLogoImage" Width="26" Height="26" Margin="0,0,8,0" 
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="SnapMini" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Model Tag -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="8,3" CornerRadius="12" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelTagText" Text="Gemini 2.5 Flash" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Position Selector Pill -->
                    <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="BtnTopLeft" MouseLeftButtonDown="SetPos_TopLeft" ToolTip="Top-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↖" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnTopRight" MouseLeftButtonDown="SetPos_TopRight" ToolTip="Top-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↗" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnCenter" MouseLeftButtonDown="SetPos_Center" ToolTip="Center Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="⊹" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomLeft" MouseLeftButtonDown="SetPos_BottomLeft" ToolTip="Bottom-Left Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↙" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBottomRight" MouseLeftButtonDown="SetPos_BottomRight" ToolTip="Bottom-Right Position" Width="22" Height="22" CornerRadius="5" Cursor="Hand" Background="Transparent">
                                <TextBlock Text="↘" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Copy Button Card -->
                    <Border Grid.Column="3" x:Name="CopyBtn" MouseLeftButtonDown="CopyButton_Click" Cursor="Hand" Background="#334155" CornerRadius="8" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CopyIcon" Text="📋 " Foreground="#E2E8F0" FontSize="11"/>
                            <TextBlock x:Name="CopyBtnText" Text="Copy" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Border Grid.Column="4" MouseLeftButtonDown="CloseButton_Click" Cursor="Hand" Background="Transparent" CornerRadius="6" Width="24" Height="24" VerticalAlignment="Center">
                        <TextBlock Text="✕" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Question / Captured Context Card -->
            <StackPanel Grid.Row="1" Margin="16,12,16,8">
                <TextBlock Text="CAPTURED CONTEXT" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="10,8">
                    <TextBox x:Name="QuestionBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="75" 
                             Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                             FontSize="13" FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>

            <!-- 3. Answer Card -->
            <DockPanel Grid.Row="2" Margin="16,4,16,12">
                <TextBlock Text="AI RESPONSE" DockPanel.Dock="Top" Foreground="#818CF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="14,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="AnswerText" TextWrapping="Wrap" Foreground="#F8FAFC" FontSize="14" LineHeight="22" FontFamily="Segoe UI"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- 4. Footer Progress Bar, Pause Control & Auto-close status -->
            <Border Grid.Row="3" Background="#0F172A" CornerRadius="0,0,15,15" Padding="16,8,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="AutoCloseProgress" Grid.Column="0" Height="4" Maximum="250" Value="250" 
                                 Foreground="#6366F1" Background="#1E293B" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Pause / Resume Button -->
                    <Border Grid.Column="1" x:Name="PauseBtn" MouseLeftButtonDown="PauseButton_Click" Cursor="Hand" 
                            Background="#334155" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseIcon" Text="⏸ " Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseBtnText" Text="Pause" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TimerLabel" Grid.Column="2" Text="Auto closing in 25s" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
