<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Specify executable output for Windows application -->
    <OutputType>WinExe</OutputType>

    <!-- Target .NET 8 with Windows 10 SDK support for native WinRT APIs -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Enable WPF and Windows Forms for UI & System Tray TrayIcon -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Copy appsettings.json to output directory when compiling -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
