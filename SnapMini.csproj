<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Specify executable output for Windows application -->
    <OutputType>WinExe</OutputType>

    <!-- Target .NET 10 with Windows 10 SDK support for native WinRT APIs -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Enable WPF and Windows Forms for UI & System Tray TrayIcon -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Executable Icon -->
    <ApplicationIcon>Images\SMini_icon_.ico</ApplicationIcon>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Copy appsettings.json and Images folder to output directory when compiling -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
